# Copy to .env.local and fill in values for this installation.
VITE_GUPPY_HOST_IP=192.168.1.100
VITE_GUPPY_HOST_PORT=3456
VITE_GUPPY_HOST_MDNS=nmm.local
VITE_GUPPY_SMB_USER=guppy
VITE_GUPPY_SMB_SHARE=jelly
VITE_GUPPY_LOCAL_SHARE=/Volumes/jelly
VITE_GUPPY_HOST_DRIVE=/Volumes/4TB0-SEAGATE
VITE_GUPPY_LAN_API_TOKEN=replace-with-a-random-local-token
VITE_GUPPY_TMDB_API_KEY=replace-with-your-tmdb-key
